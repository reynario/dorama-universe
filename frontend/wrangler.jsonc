{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dorama-universe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cache incremental do Next (ISR + cache de fetch) no R2. Sem isso o
  // adaptador nao persiste nada entre requisicoes: toda visita re-renderiza a
  // pagina e refaz as chamadas na API do Payload. Era KV, mas o plano free do
  // KV so permite 1.000 gravacoes/dia e estourava em ~1h (ver open-next.config.ts).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "doramauniverse"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Dominios (doramauniverse.com / www) foram anexados pelo painel da Cloudflare
  // (Workers > dorama-universe > Settings > Domains). Nao gerenciar por aqui:
  // a API de domains falha com o token OAuth atual.
  // As variaveis NEXT_PUBLIC_* sao definidas no painel da Cloudflare (build vars):
  //   NEXT_PUBLIC_API_URL           -> ex.: https://api.doramauniverse.com
  //   NEXT_PUBLIC_MEDIA_BASE        -> ex.: https://cdn.doramauniverse.com (opcional)
  //   NEXT_PUBLIC_ADSENSE_CLIENT    -> ca-pub-8751006394850232
}
